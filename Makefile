# gbmplast - common workflows.
#   make setup      install into .venv (see docs/INSTALL.md for PyRadiomics)
#   make data       acquire every public table (small)
#   make audit      canonicalise, validate, write data dictionaries
#   make module-a   LUMIERE longitudinal MRI
#   make module-b   radiogenomics + survival
#   make module-c   molecular plasticity
#   make all        audit + every module + report
#   make test       the full test suite
#
# Derived outputs (data/interim, data/processed, results, figures) are
# regenerated by rerunning the commands, so there is deliberately no clean
# target: nothing here deletes anything.

PY       ?= .venv/bin/python
GBM      ?= .venv/bin/gbmplast
JUPYTEXT ?= .venv/bin/jupytext
NBCONVERT ?= .venv/bin/jupyter nbconvert
DATASETS ?= lumiere,upenn_gbm,ucsd_ptgbm,gbm_care

.PHONY: setup data audit module-a module-b module-c report all test \
        test-fast notebooks images specimens help

help:
	@grep -E '^#   ' Makefile | sed 's/^#   //'

setup:
	python3.11 -m venv .venv
	$(PY) -m pip install -U pip wheel
	$(PY) -m pip install -e ".[all]"
	@echo "PyRadiomics needs two extra steps: see docs/INSTALL.md"

data:
	$(GBM) acquire --dataset $(DATASETS)

images:
	$(GBM) acquire --dataset lumiere --images --n-patients 5 --dry-run
	$(GBM) acquire --dataset lumiere --images --n-patients 5

specimens:
	$(GBM) acquire --dataset gbm_care --specimens --n-patients 56 --dry-run
	$(GBM) acquire --dataset gbm_care --specimens --n-patients 56 --max-bytes 6

audit:
	$(GBM) canonicalize --dataset $(DATASETS)
	$(GBM) validate --dataset $(DATASETS)
	$(GBM) dictionary --dataset $(DATASETS)

module-a:
	$(GBM) imaging-qc --dataset lumiere --limit 12
	$(GBM) longitudinal --dataset lumiere -c lumiere
	$(GBM) model next-visit --dataset lumiere --outcome rano -c lumiere
	$(GBM) model next-visit --dataset lumiere --outcome volume -c lumiere

module-b:
	$(GBM) radiogenomics --dataset upenn_gbm --target mgmt
	$(GBM) radiogenomics --dataset ucsd_ptgbm
	$(GBM) model survival --dataset upenn_gbm
	$(GBM) model survival --dataset lumiere

module-c:
	$(GBM) molecular pseudobulk --dataset gbm_care
	$(GBM) molecular plasticity --dataset gbm_care

report:
	$(GBM) report

all: audit module-a module-b module-c report

test:
	$(PY) -m pytest -q

test-fast:
	$(PY) -m pytest -q -m "not requires_data"

notebooks:
	$(PY) scripts/run_notebooks.py
